# Historical layout example. The reproducible build uses firmware/Makefile and build.py.
# Do not replace the pinned integration Makefile with this example.
# libDaisy must be checked out and compiled separately.
TARGET = parable_core_pass_through
CPP_SOURCES = daisy_pass_through.cpp
LIBDAISY_DIR ?= ../../libDaisy
C_INCLUDES += -I../include
include $(LIBDAISY_DIR)/core/Makefile
