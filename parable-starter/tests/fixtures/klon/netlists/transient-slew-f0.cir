C15 tout co 4.7u
R25 co lev 560
RP3top lev out 5000
RP3bottom out 0 5000
R26 byp out 68k
R27 lev out 68k
R28 out 0 100k
Rload out 0 1meg
.model Ge D(IS=600n N=1.5 EG=.67 CJO=0 TT=0 TNOM=26.85)
.subckt amp p n o params: LO=-3 HI=3
Rin p n 1e12
Bstate 0 u I=1e-6*(min(max(94.2477796076938*(200000*v(p,n)-v(u)),-13e6),13e6)-1e10*(v(u)-min(max(v(u),LO),HI)))
Cstate u 0 1u
Ecenter center 0 p9 0 .5
Edrive internal center u 0 1
Rout internal o 50
.ends

.ic v(xu1a.u)=0 v(xu1a.internal)=4.5 v(xu1b.u)=0 v(xu1b.internal)=4.5 v(xu2a.u)=0 v(xu2a.internal)=4.5 v(xu2b.u)=0 v(xu2b.internal)=4.5
